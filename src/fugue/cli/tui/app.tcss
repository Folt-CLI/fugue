#windows {
    height: 1fr;
}

#main {
    width: 1fr;
}

Window {
    border: round $primary-background-lighten-2;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

Window:focus {
    border: round $accent;
}

Window > Static {
    margin-bottom: 1;
}

Window > .placeholder {
    color: $text-muted;
}

ChecklistWindow {
    width: 38;
}

TicketWindow {
    height: 2fr;
}

LogWindow {
    height: 1fr;
}

StatusBar {
    height: 1;
    padding: 0 1;
    background: $primary-background;
}

QuestionScreen {
    align: center middle;
    background: $background 60%;
}

#dialog {
    width: 56;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#question {
    margin-bottom: 1;
}

#choices {
    height: auto;
}

#choices Button {
    margin-right: 2;
}
