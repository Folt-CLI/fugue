#windows {
    height: 1fr;
}

#pages {
    width: 1fr;
}

TabPane {
    padding: 0;
}

TabPane > Window {
    border: none;
    height: 1fr;
}

Window {
    border: round $primary-background-lighten-2;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

Window:focus {
    border: round $accent;
}

Window > Static {
    margin-bottom: 1;
}

LogWindow > Static {
    margin-bottom: 0;
}

Window > .placeholder {
    color: $text-muted;
}

ChecklistWindow {
    width: 38;
}

StatusBar {
    height: 1;
    padding: 0 1;
    background: $primary-background;
}

ActionWindow {
    height: auto;
    max-height: 60%;
    padding: 0 2;
    border: round $accent;
    background: $surface;
}

#action-text {
    text-style: bold;
}

#action-body {
    height: auto;
    max-height: 8;
    margin-top: 1;
}

#action-area {
    height: auto;
}

#action-choices {
    height: auto;
    margin-top: 1;
    grid-gutter: 0 2;
}

#action-other {
    height: 3;
    margin-top: 1;
}

#action-other .marker {
    width: 3;
    padding: 1 1 0 1;
    color: $text-muted;
}

#action-other.-chosen .marker {
    color: $accent;
}

#action-other Input {
    width: 1fr;
    border: round $panel-lighten-2;
    background: transparent;
}

#action-other Input:focus,
#action-other.-chosen Input {
    border: round $accent;
}

#action-picker {
    height: auto;
    max-height: 8;
    margin-top: 1;
    border: round $panel-lighten-2;
    background: transparent;
}

#action-picker:focus {
    border: round $accent;
}

#action-chat {
    height: auto;
    min-height: 3;
    max-height: 8;
    margin-top: 1;
    border: round $panel-lighten-2;
    background: transparent;
}

#action-chat:focus {
    border: round $accent;
}

.hint {
    color: $text-muted;
    margin-bottom: 0;
}

#action-choices Button {
    width: 100%;
    height: 3;
    border: round $panel-lighten-2;
    border-top: round $panel-lighten-2;
    border-bottom: round $panel-lighten-2;
    background: transparent;
    color: $text-muted;
    text-style: none;
}

#action-choices Button:hover {
    border: round $accent;
    color: $text;
}

#action-choices Button:focus {
    border: round $accent;
    background: $accent 25%;
    color: $text;
    text-style: bold;
}

Action {
    height: auto;
}

#action-choices Button.-picked {
    border: round $success;
    color: $text;
}

#form-header {
    height: 1;
    margin-top: 1;
}

#form-progress {
    width: 1fr;
    color: $text-muted;
}

#form-fields {
    height: auto;
    max-height: 12;
    margin-top: 1;
    border: round $panel-lighten-2;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

.form-field {
    height: auto;
    margin-bottom: 1;
}

.form-question {
    text-style: bold;
    color: $accent;
}

.form-body {
    color: $text-muted;
}

#form-submit {
    width: auto;
    min-width: 18;
    background: $success 40%;
    color: $text;
}

#form-submit:focus {
    background: $success;
    text-style: bold;
}
