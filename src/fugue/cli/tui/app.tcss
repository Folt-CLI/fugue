#windows {
    height: 1fr;
}

#pages {
    width: 1fr;
}

TabPane {
    padding: 0;
}

TabPane > Window {
    border: none;
    height: 1fr;
}

Window {
    border: round $primary-background-lighten-2;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

Window:focus {
    border: round $accent;
}

Window > Static {
    margin-bottom: 1;
}

LogWindow > Static {
    margin-bottom: 0;
}

Window > .placeholder {
    color: $text-muted;
}

ChecklistWindow {
    width: 38;
}

StatusBar {
    height: 1;
    padding: 0 1;
    background: $primary-background;
}

ActionWindow {
    height: auto;
    max-height: 60%;
    padding: 0 2;
    border: round $accent;
    background: $surface;
}

#action-text {
    text-style: bold;
}

#action-body {
    height: auto;
    max-height: 8;
    margin-top: 1;
}

#action-choices {
    height: auto;
    margin-top: 1;
}

#action-choices Button {
    margin-right: 2;
}
