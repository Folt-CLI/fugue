#steps {
    width: 34;
    padding: 1 2;
    border-right: tall $primary-background-lighten-2;
}

#feed {
    padding: 0 1;
}

#feed > Static {
    margin-bottom: 1;
}

QuestionScreen {
    align: center middle;
}

#dialog {
    width: 64;
    height: auto;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#question {
    margin-bottom: 1;
}

#choices {
    height: auto;
}

#choices Button {
    margin-right: 2;
}
